{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhastAI Companion",
  "version": "0.1.27",
  "identifier": "ai.trapezohe.companion.tray",
  "build": {
    "beforeDevCommand": "cd ui-react && npm run dev",
    "beforeBuildCommand": "cd ui-react && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui-react/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "status",
        "title": "GhastAI Companion",
        "width": 360,
        "height": 700,
        "visible": false,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Trapezohe/companion_service/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERkQ0MEIwQzlGRjI5NDgKUldSSUtmL0pzRUQ5N1piK1N1NGZVK3V3VEEyc0VQSDg0VmROdit4SjdDTmp4L1lxaGc5dWRoNHIK"
    }
  }
}
